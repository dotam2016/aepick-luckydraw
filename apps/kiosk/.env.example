# Copy to .env.local and fill in when kiosk is deployed separately from the API
# (e.g. Cloudflare Pages). Leave unset for local dev — falls back to the
# same-origin/local server via vite.config.ts's /api proxy.
VITE_API_BASE=https://your-ec2-domain.example.com

# Build-time only (not read at runtime, set it in the CI/Pages build env, not
# .env.local). Serving from a domain root (Cloudflare Pages) needs '/'; leave
# unset to keep the default '/kiosk/' used by the EC2 same-server deployment.
VITE_BASE_PATH=/
